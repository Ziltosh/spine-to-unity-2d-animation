  },
  "author": {
    "name": "Nicolas Egermann",
    "url": "https://github.com/Ziltosh"
  },
  "dependencies": {
    "com.unity.2d.animation": "16.0.1",
    "com.unity.modules.animation": "1.0.0",
    "com.unity.modules.imageconversion": "1.0.0"
  }
